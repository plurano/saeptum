# Generated by Praetor from declared project commands; build and test run
# tools/check_reuse.py until the first crate lands.
-include .config/praetor/engine.mk
# Praetor ships one binary under two names; resolve whichever is installed.
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
CARGO_DENY ?= cargo deny
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test licences advisories mutant-exclusions nosec-reasons required-checks planted-crates fetch-release semver-scope complexity

all: build

verify-all: compile-context-verify caveman-sources audit test licences advisories mutant-exclusions nosec-reasons required-checks planted-crates fetch-release semver-scope complexity

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

test: build
	@python3 -B tools/check_reuse.py selftest

build:
	@python3 -B tools/check_reuse.py

# The licence allow-list of deny.toml over the locked graph. The planted case:
# the crate under tools/deny/fixtures/refused names a licence the list does not
# allow, and cargo-deny exits 4 when a licence check fails; any other status
# means it did not run the check.
licences:
	$(CARGO_DENY) --version
	$(CARGO_DENY) --locked --config $(CURDIR)/deny.toml check licenses
	@status=0; $(CARGO_DENY) --manifest-path tools/deny/fixtures/refused/Cargo.toml \
		--locked --config $(CURDIR)/deny.toml check licenses \
		>/dev/null 2>&1 || status=$$?; test "$$status" -eq 4 \
		|| { printf 'FAIL: the planted licence was not refused: cargo-deny exited %s, not 4\n' \
		"$$status" >&2; exit 1; }
	@printf '%s\n' 'PASS: the planted licence is refused.'

# The RustSec advisories over the locked graph, then planted test cases.
# The planted crate under tools/deny/fixtures/advised exercises four levels:
# smallvec 1.6.0 (vulnerability RUSTSEC-2021-0003, direct); colored 1.9.3
# pulls atty 0.2.14, transitive, so all and not workspace reaches it (unsound
# RUSTSEC-2021-0145, unmaintained RUSTSEC-2024-0375); scopeguard 0.3.0 locked
# at the yanked version. The unused-ignore case exercises
# unused-ignored-advisory over the main graph by injecting an ignored advisory
# it does not need. cargo-deny exits 1 on errors of its own as well as when
# checks fail, and a weakened level still exits 1 through the other findings;
# each finding must be read from the JSON output with severity error.
advisories:
	$(CARGO_DENY) --version
	$(CARGO_DENY) --locked --config $(CURDIR)/deny.toml check advisories
	@python3 -B tools/check_deny_output.py --selftest
	@dir=$$(mktemp -d) || exit 1; trap 'rm -rf "$$dir"' EXIT; \
		mkdir "$$dir/src" \
		&& cp tools/deny/fixtures/advised/Cargo.toml.in "$$dir/Cargo.toml" \
		&& cp tools/deny/fixtures/advised/Cargo.lock.in "$$dir/Cargo.lock" \
		&& cp tools/deny/fixtures/advised/src/lib.rs "$$dir/src/lib.rs" || exit 1; \
		status=0; $(CARGO_DENY) --format json --manifest-path "$$dir/Cargo.toml" \
		--locked --config $(CURDIR)/deny.toml check advisories \
		>"$$dir/planted.json" 2>&1 || status=$$?; \
		python3 -B tools/check_deny_output.py --status "$$status" \
		--expect error:vulnerability:RUSTSEC-2021-0003 \
		--expect error:unsound:RUSTSEC-2021-0145 \
		--expect error:unmaintained:RUSTSEC-2024-0375 \
		--expect error:yanked:scopeguard@0.3.0 "$$dir/planted.json" \
		|| { cat "$$dir/planted.json" >&2; exit 1; }; \
		sed 's/^ignore = \[\]$$/ignore = ["RUSTSEC-2021-0003"]/' deny.toml > "$$dir/ignored.toml" || exit 1; \
		if cmp -s deny.toml "$$dir/ignored.toml"; then \
			printf '%s\n' 'FAIL: deny.toml has no line ignore = [], the unused-ignore case cannot be planted' >&2; \
			exit 1; \
		fi; \
		status=0; $(CARGO_DENY) --format json \
		--locked --config "$$dir/ignored.toml" check advisories \
		>"$$dir/ignored.json" 2>&1 || status=$$?; \
		python3 -B tools/check_deny_output.py --status "$$status" \
		--expect error:advisory-not-detected:- "$$dir/ignored.json" \
		|| { cat "$$dir/ignored.json" >&2; exit 1; }
	@printf '%s\n' 'PASS: every planted advisory level is reported.'

# Mutant-exclusion metadata: every exclude_re entry in .cargo/mutants.toml
# carries category, entered and expires; the selftest verifies the planted
# expired entry is caught.
mutant-exclusions:
	@python3 -B tools/check_mutant_exclusions.py --selftest
	@python3 -B tools/check_mutant_exclusions.py

# Inline Bandit suppressions: each `# nosec` names its rule ids and gives its
# reason after a second `#`, where Bandit does not read it; the selftest
# verifies the planted reasonless comment and the `--` form are refused.
nosec-reasons:
	@python3 -B tools/check_nosec.py --selftest
	@python3 -B tools/check_nosec.py

# Pull-request required status checks: every job in a pull-request workflow
# must be required by branch protection in .github/rulesets/main.json or listed
# in EXEMPT, and every required check must name such a job. This prevents jobs
# from running unrequired or deadlocking on non-existent jobs; the selftest
# exercises parser rules, job shapes, and exempt handling.
required-checks:
	@python3 -B tools/check_required_checks.py --selftest
	@python3 -B tools/check_required_checks.py

# Planted crate directory placement: every planted crate (publish = false, own
# workspace) must sit under a fixtures/ segment so the engine reader drops it
# and does not build a phantom library node; the selftest exercises parser
# shapes and scans a scratch git repository.
planted-crates:
	@python3 -B tools/check_planted_crates.py --selftest
	@python3 -B tools/check_planted_crates.py

# Pinned release asset fetching: tries the release download route then falls
# back to the API asset route; the selftest verifies fallback and digests.
fetch-release:
	@python3 -B tools/fetch_release.py --selftest

# The public Rust API of each library crate against the merge base with
# origin/main; a commit subject marked `!` allows a breaking change. The
# selftest verifies the package selection and the subject rule first.
# The same OS-conditional source refusal runs locally and in CI.
SEMVER_BASE ?= $(shell git merge-base origin/main HEAD 2>/dev/null)
semver-scope:
	@python3 -B tools/semver_scope.py selftest
	@python3 -B tools/semver_scope.py os-conditional
	@test -n "$(SEMVER_BASE)" || { printf '%s\n' 'FAIL: no merge base with origin/main' >&2; exit 1; }
	@python3 -B tools/semver_scope.py check --baseline-rev $(SEMVER_BASE)

# HISS-04 cyclomatic complexity: cap every tracked Rust function at 10, with
# lizard pinned and installed by pip's hash-enforcing path. The selftest
# refuses CCN 11 (including ? operators), accepts 10, and fails closed on an
# empty file list or zero functions. Rebuild only when the lock file changes.
LIZARD_VENV := $(CURDIR)/.cache/lizard-venv
$(LIZARD_VENV)/stamp: tools/complexity/requirements.txt
	rm -rf $(LIZARD_VENV)
	python3 -m venv $(LIZARD_VENV)
	$(LIZARD_VENV)/bin/python -m pip install --quiet --disable-pip-version-check --require-hashes --no-deps -r tools/complexity/requirements.txt
	touch $@

complexity: $(LIZARD_VENV)/stamp
	@$(LIZARD_VENV)/bin/python -I -B tools/check_complexity.py --selftest
	@$(LIZARD_VENV)/bin/python -I -B tools/check_complexity.py
