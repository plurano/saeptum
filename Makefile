# Generated by Praetor from declared project commands; build and test run
# tools/check_reuse.py until the first crate lands.
-include .config/praetor/engine.mk
# Praetor ships one binary under two names; resolve whichever is installed.
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
CARGO_DENY ?= cargo deny
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test licences mutant-exclusions nosec-reasons semver-scope

all: build

verify-all: compile-context-verify caveman-sources audit test licences mutant-exclusions nosec-reasons semver-scope

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

test: build
	@python3 -B tools/check_reuse.py selftest

build:
	@python3 -B tools/check_reuse.py

# The licence allow-list of deny.toml over the locked graph. The planted case:
# the crate under tools/deny/refused names a licence the list does not allow,
# and cargo-deny exits 4 when a licence check fails; any other status means it
# did not run the check.
licences:
	$(CARGO_DENY) --version
	$(CARGO_DENY) --locked --config $(CURDIR)/deny.toml check licenses
	@status=0; $(CARGO_DENY) --manifest-path tools/deny/refused/Cargo.toml \
		--locked --config $(CURDIR)/deny.toml check licenses \
		>/dev/null 2>&1 || status=$$?; test "$$status" -eq 4 \
		|| { printf 'FAIL: the planted licence was not refused: cargo-deny exited %s, not 4\n' \
		"$$status" >&2; exit 1; }
	@printf '%s\n' 'PASS: the planted licence is refused.'

# Mutant-exclusion metadata: every exclude_re entry in .cargo/mutants.toml
# carries category, entered and expires; the selftest verifies the planted
# expired entry is caught.
mutant-exclusions:
	@python3 -B tools/check_mutant_exclusions.py --selftest
	@python3 -B tools/check_mutant_exclusions.py

# Inline Bandit suppressions: each `# nosec` names its rule ids and gives its
# reason after a second `#`, where Bandit does not read it; the selftest
# verifies the planted reasonless comment and the `--` form are refused.
nosec-reasons:
	@python3 -B tools/check_nosec.py --selftest
	@python3 -B tools/check_nosec.py

# The public Rust API of each library crate against the merge base with
# origin/main; a commit subject marked `!` allows a breaking change. The
# selftest verifies the package selection and the subject rule first.
SEMVER_BASE ?= $(shell git merge-base origin/main HEAD 2>/dev/null)
semver-scope:
	@python3 -B tools/semver_scope.py selftest
	@test -n "$(SEMVER_BASE)" || { printf '%s\n' 'FAIL: no merge base with origin/main' >&2; exit 1; }
	@python3 -B tools/semver_scope.py check --baseline-rev $(SEMVER_BASE)
